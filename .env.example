EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Gemini is used only inside the Supabase Edge Function `detect-fridge-items`.
# Set the server secret in the Supabase Dashboard (Project Settings → Edge Functions → Secrets), or:
#   supabase secrets set GEMINI_API_KEY=your_key
# Do not put Gemini keys in this file or in the mobile app bundle.
