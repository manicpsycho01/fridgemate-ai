{
  "expo": {
    "scheme": "fridgemate",
    "name": "FridgeMate AI",
    "slug": "fridgemate-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "FridgeMate AI needs photo library access to choose a fridge photo for the demo.",
        "NSCameraUsageDescription": "FridgeMate AI uses the camera to take a fridge photo if you prefer that over the gallery."
      },
      "bundleIdentifier": "com.manicpsycho01.fridgemate"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2A66FF"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.manicpsycho01.fridgemate"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow FridgeMate AI to access your photos to pick a fridge image for the demo.",
          "cameraPermission": "Allow FridgeMate AI to use the camera to photograph your fridge."
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FBF7F0"
        }
      ],
      "expo-status-bar"
    ]
  }
}
